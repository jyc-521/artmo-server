# 공유 가능한 예시 파일입니다. 실제 값은 .env에 넣고, .env는 GitHub에 올리지 않습니다.
PORT=3000
NODE_ENV=development

# Supabase > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_with_your_real_key

# 배포된 클라이언트 주소를 쉼표로 구분해 적습니다. 와일드카드(*)는 쓰지 않습니다.
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

# Google AI Studio > Get API key
GEMINI_API_KEY=replace_with_your_gemini_key
GEMINI_MODEL_RECOMMEND=gemini-3.1-flash-lite
GEMINI_MODEL_TAGGING=gemini-3.5-flash

# 로그인 화면에 보여줄 소셜 로그인 (Supabase Auth에서 켠 것만 적기)
AUTH_PROVIDERS=google,naver

# 추천 하루 횟수 제한
DAILY_LIMIT_ANON=3
DAILY_LIMIT_USER=10
